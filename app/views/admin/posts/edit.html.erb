<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold">Edit post</h1>
  <% if @post.published? %>
    <a href="<%= post_path(slug: @post.slug) %>" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">View on site &rarr;</a>
  <% end %>
</div>

<%= render "form", post: @post, url: admin_post_path(@post), method: :patch %>
