<h1 class="text-2xl font-bold mb-8">Site info</h1>

<%= form_with model: @site, url: admin_site_path, method: :patch, class: "space-y-6" do |f| %>
  <% if @site.errors.any? %>
    <div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
      <% @site.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <label for="site_title" class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-gray-400 font-normal">(shown in header, footer, RSS, browser tab)</span></label>
    <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent", autofocus: true %>
  </div>

  <div>
    <label for="site_tagline" class="block text-sm font-medium text-gray-700 mb-1">Tagline <span class="text-gray-400 font-normal">(shown under the title)</span></label>
    <%= f.text_area :tagline, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
  </div>

  <div>
    <label for="site_meta_description" class="block text-sm font-medium text-gray-700 mb-1">Meta description <span class="text-gray-400 font-normal">(SEO + RSS description)</span></label>
    <%= f.text_area :meta_description, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
  </div>

  <div class="pt-2">
    <%= f.submit "Save", class: "bg-gray-900 text-white rounded-lg px-6 py-2 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
  </div>
<% end %>
