<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin — <%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 antialiased">
    <div class="max-w-4xl mx-auto px-6 py-8">
      <header class="flex items-center justify-between mb-8 pb-4 border-b border-gray-200">
        <div class="flex items-center gap-6">
          <a href="<%= admin_posts_path %>" class="text-lg font-bold text-gray-900 no-underline">Admin</a>
          <nav class="flex items-center gap-4 text-sm text-gray-500">
            <a href="<%= admin_posts_path %>" class="hover:text-gray-900 transition-colors">Posts</a>
            <a href="<%= root_path %>" class="hover:text-gray-900 transition-colors">View site</a>
          </nav>
        </div>
        <%= button_to "Logout", logout_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-900 transition-colors cursor-pointer" %>
      </header>

      <% if flash[:notice] %>
        <div class="mb-6 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-4 py-3"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-6 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3"><%= flash[:alert] %></div>
      <% end %>

      <main>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
