<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "A personal blog" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="<%= feed_url(format: :rss) %>">
    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <div class="max-w-2xl mx-auto px-6 py-12 sm:py-16">
      <header class="mb-16">
        <a href="<%= root_path %>" class="no-underline">
          <h1 class="text-2xl font-bold tracking-tight text-gray-900">Andrey Esaulov</h1>
        </a>
        <p class="mt-2 text-gray-500 text-base leading-relaxed">
          Software engineer. Writing about code, technology, and ideas.
        </p>
        <nav class="mt-4 flex items-center gap-4 text-sm text-gray-500">
          <a href="<%= root_path %>" class="hover:text-gray-900 transition-colors">Posts</a>
          <a href="<%= feed_path(format: :rss) %>" class="hover:text-gray-900 transition-colors">RSS</a>
          <% if logged_in? %>
            <a href="<%= admin_posts_path %>" class="hover:text-gray-900 transition-colors">Admin</a>
            <%= button_to "Logout", logout_path, method: :delete, class: "hover:text-gray-900 transition-colors cursor-pointer", form: { class: "inline" } %>
          <% end %>
        </nav>
      </header>

      <% if flash[:notice] %>
        <div class="mb-8 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-4 py-3"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-8 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3"><%= flash[:alert] %></div>
      <% end %>

      <main>
        <%= yield %>
      </main>

      <footer class="mt-20 pt-8 border-t border-gray-100 text-sm text-gray-400">
        &copy; <%= Date.current.year %> Andrey Esaulov
      </footer>
    </div>
  </body>
</html>
